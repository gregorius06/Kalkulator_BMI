<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BmiController">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
    </padding>
    <children>
        <Label styleClass="judul" text="Kalkulator BMI" />
        <Label styleClass="subjudul" text="Isi data, pilih standar, lalu hitung BMI." />

        <Label text="Nama" />
        <TextField fx:id="txtNama" promptText="Contoh: Andi" />

        <Label text="Standar kategori" />
        <ComboBox fx:id="cbStandar" maxWidth="Infinity" />
        <Label styleClass="info" wrapText="true"
               text="WHO: normal 18,5–24,9 • Asia-Pasifik: normal 18,5–22,9" />

        <Label text="Berat badan (kg)" />
        <TextField fx:id="txtBerat" promptText="Contoh: 60" />

        <Label text="Tinggi badan (cm)" />
        <TextField fx:id="txtTinggi" promptText="Contoh: 170" />

        <Button maxWidth="Infinity" minHeight="46.0" onAction="#handleHitung"
                styleClass="tombol-utama" text="Hitung BMI">
            <VBox.margin>
                <Insets top="6.0" />
            </VBox.margin>
        </Button>

        <Button onAction="#handleReset" text="Reset" />
        <Button onAction="#handleKembali" text="Kembali" />

        <Label fx:id="lblHasil" styleClass="hasil" wrapText="true" />
        <Label fx:id="lblKategori" styleClass="kategori" wrapText="true" />
    </children>
</VBox>
